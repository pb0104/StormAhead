# No keys are required for the default demo. All values optional.
PORT=3001
# Delay between agent steps so the activity feed is watchable (ms). Use 0 for tests/CI.
DEMO_STEP_DELAY_MS=250
# SQLite file (defaults to data/cascadeiq.sqlite, git-ignored)
# CASCADEIQ_DB=./data/cascadeiq.sqlite
# Reserved for the optional LLM coordinator (NOT implemented in this build). Keep server-side only.
# LLM_API_KEY=
