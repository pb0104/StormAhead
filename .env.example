# No keys are required to run StormAhead. All values are optional.
PORT=3001

# --- Adapters (each defaults to the value shown) ---
# WEATHER_ADAPTER=openmeteo   | mock
# ASSETS_ADAPTER=overpass     | mock
# LLM_ADAPTER=mock            | vertex

# --- Gemini on Vertex AI (optional; only read when LLM_ADAPTER=vertex) ---
# There is NO API key. The Google Cloud org disallows them by policy, so auth is
# Application Default Credentials. Run these once per machine:
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project <project-id>
# Then set:
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global        # or us-central1
# VERTEX_MODEL=gemini-2.5-flash
# Check it with: curl localhost:3001/api/llm/status

# Only needed to rebuild real-data caches (scripts/fetch_*):
# OPENCELLID_KEY=       free key from opencellid.org
# EARTHDATA_TOKEN=      NASA Earthdata token (urs.earthdata.nasa.gov)
