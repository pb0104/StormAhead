# No keys are required. All values optional.
PORT=3001
# Only needed to rebuild real-data caches (scripts/fetch_*):
# OPENCELLID_KEY=       free key from opencellid.org
# EARTHDATA_TOKEN=      NASA Earthdata token (urs.earthdata.nasa.gov)
# Forecast console LLM (StackAI). Deploy a flow: Input (in-0) → LLM (prompt: {in-0}) → Output (out-0).
# The org and flow ids are in the flow's Export → API snippet: /inference/v0/run/{ORG_ID}/{FLOW_ID}
# STACKAI_API_KEY=
# STACKAI_ORG_ID=
# STACKAI_FLOW_ID=
# STACKAI_INPUT=in-0
# STACKAI_OUTPUT=out-0
# Live voice (Vertex Gemini Live → spoken replies). Needs gcloud auth or ADC.
# VERTEX_PROJECT_ID=
# VERTEX_LOCATION=us-central1
# VERTEX_LIVE_MODEL=gemini-3.8-live
# VERTEX_LIVE_VOICE=Aoede
# Higher-resolution base imagery (Google Map Tiles API, 2D satellite, native zoom 20 over the valley).
# GOOGLE_MAPS_API_KEY=          needs the "Map Tiles API" enabled; stays server-side
# GOOGLE_TILES_DAILY_BUDGET=25000   tiles per day before the map falls back to Esri
